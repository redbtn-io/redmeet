{
  "name": "@redmeet/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared zod schemas, types and pure functions for redMeet (web). No I/O here, pure domain logic only: slugs, booking inputs, availability math.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}