# redMeet environment. NAMES ONLY: no value in this file is ever a real secret,
# and no file in this repository carries one.
#
# Every name below is read through `lib/config.ts`, which validates at FIRST USE
# and never at module load: RedRun's appConfig.env is a runtime environment, and
# a value read during `next build` is either baked into an image layer or absent.
#
# NODE_ENV and NODE_OPTIONS are never set in appConfig.env. They leak into the
# build and break `npm ci`'s devDependency install.

# ---- session and app ----
BASE_URL=
ACCOUNTS_URL=
COOKIE_NAME=
COOKIE_DOMAIN=
JWT_SECRET=<redacted>
# ---- calendar (MCP gateway, google/calendar namespace) ----
MCP_GATEWAY_URL=
REDMEET_MCP_PAT=
